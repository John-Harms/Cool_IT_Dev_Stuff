    <script>
      // Client-side interceptor logic
      document.addEventListener("DOMContentLoaded", () => {
        const updateNavHighlight = (activeUrl) => {
          // Define active and inactive class arrays
          const activeClasses = [
            "text-primary",
            "dark:text-primary-fixed",
            "border-b-2",
            "border-primary",
            "pb-1",
          ];
          const inactiveClasses = [
            "text-secondary",
            "dark:text-secondary-fixed-dim",
          ];

          document.querySelectorAll(".nav-bar-button").forEach((link) => {
            const targetUrl = link.getAttribute("href");

            if (targetUrl === activeUrl) {
              // Add active styles, remove inactive styles
              link.classList.add(...activeClasses);
              link.classList.remove(...inactiveClasses);
            } else {
              // Remove active styles, add inactive styles
              link.classList.remove(...activeClasses);
              link.classList.add(...inactiveClasses);
            }
          });
        };

        // A delegated click handler on the document
        document.addEventListener("click", async (e) => {
          // Find the closest parent <a> that has the class 'nav-button'
          const link = e.target.closest(".nav-button");
          if (!link) return; // Not a nav button click, ignore
          e.preventDefault(); // Stop standard browser behavior
          const targetUrl = link.getAttribute("href");
          try {
            let currentURL = window.location.pathname;
            if (currentURL == "/") {
              currentURL = "/home";
            }
            console.log(currentURL);
            if (currentURL != targetUrl) {
              const response = await fetch(`${targetUrl}?ajax=true`);
              if (!response.ok) throw new Error("Failed to load segment");

              const htmlFragment = await response.text();

              // Swap out the content
              document.getElementById("main-content").innerHTML = htmlFragment;

              // Update the browser URL without reloading the page
              history.pushState(null, "", targetUrl);

              updateNavHighlight(targetUrl);

              window.scrollTo(0, 0);
            }
          } catch (err) {
            console.error(err);
          }
        });
      });
      // Handle browser Back/Forward buttons smoothly
      window.addEventListener("popstate", () => {
        window.location.reload(); // Simplest fix for back-button sync, or re-fetch content based on window.location
      });
    </script>

    <style>
      body {
        background-color: #f7f9fb;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .alpine-bg {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        overflow: hidden;
        opacity: 0.2;
      }
      .sun {
        position: absolute;
        bottom: 30%;
        left: 50%;
        transform: translateX(-50%);
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: radial-gradient(circle, #ff7e5f 0%, #feb47b 100%);
        filter: blur(20px);
        opacity: 0.8;
        animation: pulse 10s infinite alternate;
      }
      @keyframes pulse {
        0% {
          transform: translateX(-50%) scale(1);
          filter: blur(20px);
          opacity: 0.8;
        }
        100% {
          transform: translateX(-50%) scale(1.1);
          filter: blur(30px);
          opacity: 0.6;
        }
      }
