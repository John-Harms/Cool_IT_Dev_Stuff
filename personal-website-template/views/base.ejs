    <!-- Fixed Background -->
    <div class="alpine-bg">
      <svg
        class="absolute overflow-visible top-32 right-[-10%] md:right-[5%] w-[120%] md:w-[70%] h-[600px]"
        preserveaspectratio="xMidYMid meet"
        viewbox="0 0 1000 500"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <filter
            height="200%"
            id="neonOrangeGlow"
            width="200%"
            x="-50%"
            y="-50%"
          >
            <fegaussianblur
              in="SourceGraphic"
              result="blur1"
              stddeviation="4"
            ></fegaussianblur>
            <fegaussianblur
              in="SourceGraphic"
              result="blur2"
              stddeviation="8"
            ></fegaussianblur>
            <femerge>
              <femergenode in="blur2"></femergenode>
              <femergenode in="blur1"></femergenode>
              <femergenode in="SourceGraphic"></femergenode>
            </femerge>
          </filter>
        </defs>
        <!-- Sun -->
        <g transform="translate(-100, 0)">
          <g transform="translate(450, 150)">
            <!-- Rays -->
            <g
              filter="url(#neonOrangeGlow)"
              stroke="#ff5500"
              stroke-linecap="round"
              stroke-width="3"
            >
              <line x1="0" x2="0" y1="-45" y2="-70"></line>
              <line x1="0" x2="0" y1="45" y2="70"></line>
              <line x1="-45" x2="-70" y1="0" y2="0"></line>
              <line x1="45" x2="70" y1="0" y2="0"></line>
              <line x1="-32" x2="-49" y1="-32" y2="-49"></line>
              <line x1="32" x2="49" y1="32" y2="49"></line>
              <line x1="-32" x2="-49" y1="32" y2="49"></line>
              <line x1="32" x2="49" y1="-32" y2="-49"></line>
            </g>
            <!-- Core -->
            <circle
              cx="0"
              cy="0"
              fill="#000000"
              filter="url(#neonOrangeGlow)"
              r="30"
              stroke="#ff5500"
              stroke-width="2"
            ></circle>
            <circle cx="0" cy="0" fill="#000000" r="30"></circle>
          </g>
          <!-- Mountains -->
          <g
            fill="none"
            stroke="#1e293b"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          >
            <polyline
              points="0,400 150,400 350,250 450,330 550,180 700,350 850,280 1000,400"
            ></polyline>
            <polyline
              points="200,400 400,280 480,350 600,220 750,380 900,320 1000,400"
            ></polyline>
            <!-- Base Line -->
            <line x1="-75" x2="1000" y1="400" y2="400"></line>
          </g>
        </g>
      </svg>
    </div>
    <!-- Top Navigation Bar -->
