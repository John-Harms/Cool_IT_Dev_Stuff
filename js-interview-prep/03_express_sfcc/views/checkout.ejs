<%- include('layout-header', { activePage: 'checkout', title: 'Heritage Boots Storefront - Checkout' }) %>

<div class="card" style="max-width: 600px; margin: 0 auto 2rem;">
    <h1 style="font-size: 1.8rem; margin-bottom: 0.5rem; text-align: center;">Secure Checkout</h1>
    <p style="text-align: center; font-size: 0.9rem; margin-bottom: 2rem;">Confirm your details to finalize the simulated purchase order.</p>

    <!-- Error/Success Alerts -->
    <% if (locals.error) { %>
        <div class="alert alert-danger">
            <strong>Security Warning:</strong> <%= error %>
        </div>
    <% } %>
    
    <% if (locals.validationErrors && validationErrors.length > 0) { %>
        <div class="alert alert-danger" style="display: block;">
            <strong>Validation Failed:</strong>
            <ul style="margin-top: 5px; margin-left: 20px; font-size: 0.9rem;">
                <% validationErrors.forEach(err => { %>
                    <li><%= err %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <% if (locals.success) { %>
        <div class="alert alert-success">
            <strong>Success:</strong> Order created successfully! Your mock Order ID is <strong><%= orderId %></strong>.
        </div>
    <% } %>

    <form action="/checkout" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
        
        <!-- CSRF Token Input Field (Hidden) -->
        <!-- In SFCC, forms are protected using form object metadata tokens. Here, we inject it manually. -->
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="form-group">
            <label for="fullName">Full Name</label>
            <input type="text" id="fullName" name="fullName" placeholder="John Doe" value="<%= locals.formData?.fullName ?? '' %>" required />
        </div>

        <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="johndoe@example.com" value="<%= locals.formData?.email ?? '' %>" required />
        </div>

        <div class="form-group">
            <label for="cardNumber">Credit Card Number</label>
            <input type="text" id="cardNumber" name="cardNumber" placeholder="1111-2222-3333-4444" value="<%= locals.formData?.cardNumber ?? '' %>" required />
            <small style="color: var(--text-muted); font-size: 0.75rem; margin-top: 2px;">Enter exactly 16 digits (hyphens/spaces are ignored).</small>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
            <div class="form-group">
                <label for="expDate">Expiration Date</label>
                <input type="text" id="expDate" name="expDate" placeholder="MM/YY" value="<%= locals.formData?.expDate ?? '' %>" required />
            </div>
            <div class="form-group">
                <label for="cvv">CVV</label>
                <input type="text" id="cvv" name="cvv" placeholder="321" value="<%= locals.formData?.cvv ?? '' %>" required />
            </div>
        </div>

        <div style="margin-top: 1rem;">
            <button type="submit" class="btn" style="width: 100%; font-size: 1.1rem; padding: 1rem;">Complete Purchase</button>
        </div>
    </form>
</div>

<!-- CSRF Token Tamper Demonstration Panel -->
<div class="card" style="max-width: 600px; margin: 2rem auto 0;">
    <h2>🛡️ CSRF Verification Tester</h2>
    <p>To test how the backend handles CSRF hacks, you can manually tamper with the form parameters in your browser, or click the button below to submit a post request <strong>without</strong> a CSRF token.</p>
    
    <form action="/checkout" method="POST" style="margin-top: 1rem;">
        <!-- Emitting a POST request without the _csrf field -->
        <input type="hidden" name="fullName" value="Hacker Dan" />
        <input type="hidden" name="email" value="hacker@fraud.com" />
        <input type="hidden" name="cardNumber" value="1234123412341234" />
        <input type="hidden" name="expDate" value="12/30" />
        <input type="hidden" name="cvv" value="999" />
        
        <button type="submit" class="btn" style="background: var(--danger); width: 100%;">Submit Form Without CSRF Token (Simulate Attack)</button>
    </form>
</div>

<%- include('layout-footer') %>
